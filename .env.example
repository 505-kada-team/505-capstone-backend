# ==== Server ====
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ==== Database ====
MONGO_URI=mongodb://127.0.0.1:27017/kada_dev

# ==== Rate limit ====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ==== Fitur mendatang ====
# Variabel untuk modul Authentication (JWT_*, OTP_*, BREVO_*, SMTP_*)
# ditambahkan di sini begitu modul tersebut mulai dikerjakan, sekaligus
# di-tambahkan validasinya di src/config/env.js.
