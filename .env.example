# ==== Server ====
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ==== Database ====
MONGO_URI=mongodb://127.0.0.1:27017/kada_dev

# ==== Rate limit ====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# JWT
JWT_ACCESS_SECRET=ganti_dengan_secret_yang_kuat_min_32_karakter
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=ganti_dengan_secret_lain_yang_kuat_min_32_karakter
JWT_REFRESH_EXPIRES=7d
JWT_RESET_SECRET=ganti_dengan_secret_ketiga_yang_kuat_min_32_karakter
JWT_RESET_EXPIRES=10m

# Brevo
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_USER=xxxxx@gmail.com
SMTP_FROM_NAME=xxxxxxxxxxxxxxxx

# OTP
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Cloudinary
CLOUDINARY_CLOUD_NAME=xxxxxxxxxxxxxxxxxxxxx
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxx
