{
  "info": {
    "_postman_id": "b1f2a2e0-7b1a-4a3e-9f0a-menu-kada-0001",
    "name": "KADA - Menu Service",
    "description": "Flow testing untuk Menu module KADA (create, read, update, delete, dropdown) beserta efek cascade ke Production Plan (checkResultStale / staleReason).\n\nUrutan folder \"Happy Path Flow\" didesain untuk dijalankan berurutan (pakai Postman Runner) karena saling bergantung lewat collection variable `menuId`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "menuId", "value": "", "type": "string" },
    {
      "key": "inventoryIdA",
      "value": "",
      "type": "string",
      "description": "ObjectId Inventory berstatus active, dipakai sebagai ingredient"
    },
    {
      "key": "inventoryIdB",
      "value": "",
      "type": "string",
      "description": "ObjectId Inventory active kedua, untuk edit recipe"
    },
    {
      "key": "inventoryIdArchived",
      "value": "",
      "type": "string",
      "description": "ObjectId Inventory berstatus deleted, untuk uji costComplete:false"
    }
  ],
  "item": [
    {
      "name": "Happy Path Flow",
      "item": [
        {
          "name": "1. Create Menu",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test('Menu punya _id', function () { pm.expect(json.data._id).to.exist; });",
                  "if (json.data && json.data._id) { pm.collectionVariables.set('menuId', json.data._id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nasi Goreng Spesial\",\n  \"description\": \"Nasi goreng dengan telur dan ayam suwir\",\n  \"image\": null,\n  \"sellingPrice\": 25000,\n  \"ingredients\": [\n    { \"inventoryId\": \"{{inventoryIdA}}\", \"quantityNeeded\": 2 },\n    { \"inventoryId\": \"{{inventoryIdB}}\", \"quantityNeeded\": 1 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/menu",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu"]
            },
            "description": "Buat menu baru. Backend memvalidasi tiap inventoryId harus resolve ke Inventory status active dan tidak boleh duplikat (lihat validateIngredients). Response menyertakan cost breakdown live dari Inventory saat ini."
          }
        },
        {
          "name": "2. Get Menus (List + Pagination + Search)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Ada pagination', function () { pm.expect(json.pagination).to.exist; });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/menu?page=1&limit=10&search=&includeDeleted=false",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "" },
                { "key": "includeDeleted", "value": "false" }
              ]
            },
            "description": "Default filter hanya status active. Set includeDeleted=true untuk melihat menu yang sudah diarsipkan juga."
          }
        },
        {
          "name": "3. Get Menu Dropdown",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Response array, field minimal', function () {",
                  "  pm.expect(json.data).to.be.an('array');",
                  "  if (json.data.length > 0) {",
                  "    pm.expect(json.data[0]).to.have.all.keys('_id','name','sellingPrice','image');",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/menu/dropdown?search=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu", "dropdown"],
              "query": [{ "key": "search", "value": "" }]
            },
            "description": "Endpoint ringan untuk dropdown/selector, hanya field _id, name, sellingPrice, image. Hanya menu active."
          }
        },
        {
          "name": "4. Get Menu By Id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Ingredients ter-populate live dari Inventory', function () {",
                  "  pm.expect(json.data.ingredients).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/menu/{{menuId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu", "{{menuId}}"]
            },
            "description": "Detail menu, termasuk cost breakdown penuh per ingredient. Jika ada ingredient yang Inventory-nya diarsipkan/belum punya batch, costComplete=false dan muncul field `warning`."
          }
        },
        {
          "name": "5. Update Menu - Name/Description Only (no cascade)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('affectedDraftPlans kosong karena bukan ingredients/sellingPrice', function () {",
                  "  pm.expect(json.affectedDraftPlans).to.be.an('array').that.is.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nasi Goreng Spesial (Update Nama)\",\n  \"description\": \"Deskripsi diperbarui, tidak menyentuh resep/harga\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/menu/{{menuId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu", "{{menuId}}"]
            },
            "description": "Update yang hanya menyentuh name/description/image TIDAK memicu stale cascade ke draft Production Plan."
          }
        },
        {
          "name": "6. Update Menu - Ingredients/Price (triggers stale cascade)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('affectedDraftPlans field ada (bisa kosong jika tidak ada draft plan terkait)', function () {",
                  "  pm.expect(json.affectedDraftPlans).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sellingPrice\": 27000,\n  \"ingredients\": [\n    { \"inventoryId\": \"{{inventoryIdA}}\", \"quantityNeeded\": 3 },\n    { \"inventoryId\": \"{{inventoryIdB}}\", \"quantityNeeded\": 1 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/menu/{{menuId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu", "{{menuId}}"]
            },
            "description": "Mengganti sellingPrice dan/atau ingredients (full replace, bukan patch) akan menandai semua draft Production Plan yang mereferensikan menu ini menjadi checkResultStale=true dengan staleReason='recipe_changed'."
          }
        },
        {
          "name": "7. Delete Menu (soft delete + cascade)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Status jadi deleted', function () { pm.expect(json.data.status).to.eql('deleted'); });",
                  "pm.test('deletedAt terisi', function () { pm.expect(json.data.deletedAt).to.exist; });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/menu/{{menuId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu", "{{menuId}}"]
            },
            "description": "Soft delete tanpa guard (tidak ada pengecekan seperti 'active stock' pada Inventory). Otomatis flag semua draft Production Plan terkait dengan staleReason='menu_archived'."
          }
        },
        {
          "name": "8. Get Menu By Id - After Delete (expect 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404 karena sudah deleted', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/menu/{{menuId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu", "{{menuId}}"]
            },
            "description": "getMenuById memfilter status != deleted, jadi setelah delete endpoint ini harus 404."
          }
        }
      ]
    },
    {
      "name": "Validation & Edge Cases",
      "item": [
        {
          "name": "Create Menu - Duplicate inventoryId (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', function () { pm.response.to.have.status(400); });",
                  "const json = pm.response.json();",
                  "pm.test('Pesan error duplicate', function () {",
                  "  pm.expect(json.message).to.include('lebih dari satu kali');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Menu Invalid - Duplicate Ingredient\",\n  \"sellingPrice\": 15000,\n  \"ingredients\": [\n    { \"inventoryId\": \"{{inventoryIdA}}\", \"quantityNeeded\": 1 },\n    { \"inventoryId\": \"{{inventoryIdA}}\", \"quantityNeeded\": 2 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/menu",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu"]
            },
            "description": "inventoryId yang sama muncul dua kali dalam satu payload harus ditolak oleh validateIngredients."
          }
        },
        {
          "name": "Create Menu - Inventory Tidak Valid/Deleted (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 400', function () { pm.response.to.have.status(400); });"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Menu Invalid - Inventory Archived\",\n  \"sellingPrice\": 15000,\n  \"ingredients\": [\n    { \"inventoryId\": \"{{inventoryIdArchived}}\", \"quantityNeeded\": 1 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/menu",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu"]
            },
            "description": "inventoryId yang statusnya bukan 'active' (mis. sudah deleted) atau tidak ditemukan sama sekali harus ditolak saat create."
          }
        },
        {
          "name": "Get Menu By Id - Not Found (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 404', function () { pm.response.to.have.status(404); });"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/menu/000000000000000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu", "000000000000000000000000"]
            },
            "description": "ObjectId valid secara format tapi tidak ada di DB -> 404 'Menu tidak ditemukan'."
          }
        },
        {
          "name": "Get Menus - Include Deleted",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/menu?includeDeleted=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu"],
              "query": [{ "key": "includeDeleted", "value": "true" }]
            },
            "description": "Menampilkan menu deleted juga di list, untuk cross-check hasil endpoint 7 (Delete Menu)."
          }
        }
      ]
    }
  ]
}
