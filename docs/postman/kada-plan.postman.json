{
  "info": {
    "name": "KADA Backend - Production Plan API",
    "_postman_id": "kada-production-plan-api",
    "description": "Production Plan endpoints for KADA Backend (A1-A10). Path dicocokkan ke plan.routes.js asli. Seluruh endpoint di-gate authenticate() -> wajib Authorization: Bearer {{authToken}} di tiap request (sudah diset di collection-level auth, lihat 'auth' key). `actor` pada approve KEMUNGKINAN diambil dari req.user (hasil authenticate), bukan dari body -- field actor di body A6 dibiarkan sebagai fallback, hapus kalau controller memang pakai req.user.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    }
  ],
  "item": [
    {
      "name": "Plan CRUD & Lifecycle",
      "item": [
        {
          "name": "A1 - Create Plan (draft)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Promo Akhir Bulan\",\n  \"tags\": [\"promo\", \"weekend\"],\n  \"startDate\": \"2024-03-01\",\n  \"duration\": 14,\n  \"menus\": [\n    {\n      \"menuId\": \"{{menuId}}\",\n      \"quantityPlanned\": 100\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/plan",
              "host": ["{{baseUrl}}"],
              "path": ["plan"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Plan created as draft', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.status).to.eql('draft');",
                  "    pm.expect(jsonData.data).to.have.property('checkResult');",
                  "    pm.expect(jsonData.data).to.have.property('readyToApprove');",
                  "});",
                  "",
                  "pm.test('Store plan ID', function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data._id) {",
                  "        pm.environment.set('planId', jsonData.data._id);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "A2 - List Plans",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/plan?status=draft&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["plan"],
              "query": [
                { "key": "status", "value": "draft" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "tags", "value": "", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Pagination data exists', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.pagination).to.have.property('totalData');",
                  "    pm.expect(jsonData.data.pagination).to.have.property('currentPage');",
                  "});",
                  "",
                  "pm.test('Each item has hasUnsafeBatch flag', function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data.data.length > 0) {",
                  "        pm.expect(jsonData.data.data[0]).to.have.property('hasUnsafeBatch');",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "A3 - Get Plan Detail (breakdown per menu)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/plan/{{planId}}",
              "host": ["{{baseUrl}}"],
              "path": ["plan", "{{planId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Detail has suggestion & inventorySafetyStatus', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('suggestion');",
                  "    pm.expect(jsonData.data).to.have.property('inventorySafetyStatus');",
                  "});",
                  "",
                  "pm.test('Draft plan has ingredientsDetail per menu', function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data.status === 'draft' && jsonData.data.menus.length > 0) {",
                  "        pm.expect(jsonData.data.menus[0]).to.have.property('ingredientsDetail');",
                  "        pm.expect(jsonData.data.menus[0]).to.have.property('lowStock');",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "A4 - Update Plan (draft only)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Promo Akhir Bulan (Revisi)\",\n  \"duration\": 21,\n  \"menus\": [\n    {\n      \"menuId\": \"{{menuId}}\",\n      \"quantityPlanned\": 150\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/plan/{{planId}}",
              "host": ["{{baseUrl}}"],
              "path": ["plan", "{{planId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('checkResultStale reset after edit', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.checkResultStale).to.be.false;",
                  "    pm.expect(jsonData.data.staleReason).to.be.null;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "A8 - Cancel Plan (draft only)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/plan/{{planId}}",
              "host": ["{{baseUrl}}"],
              "path": ["plan", "{{planId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Plan cancelled', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.status).to.eql('cancelled');",
                  "    pm.expect(jsonData.data.cancelledAt).to.not.be.null;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Availability & Approval",
      "item": [
        {
          "name": "A5 - Check Availability (refresh, draft only)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/plan/{{planId}}/check-availability",
              "host": ["{{baseUrl}}"],
              "path": ["plan", "{{planId}}", "check-availability"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Stale flag reset after refresh', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.checkResultStale).to.be.false;",
                  "    pm.expect(jsonData.data.staleReason).to.be.null;",
                  "    pm.expect(jsonData.data).to.have.property('readyToApprove');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "A6 - Approve Plan (draft -> active)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/plan/{{planId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["plan", "{{planId}}", "approve"]
            },
            "description": "Body sengaja dikosongkan -- actor kemungkinan besar diambil controller dari req.user (hasil authenticate() middleware), bukan dari body. Kalau ternyata controller.js baca actor dari body, tambahkan lagi: { \"actor\": { \"name\": \"Admin Dapur\" } }"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Plan is now active', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.status).to.eql('active');",
                  "    pm.expect(jsonData.data.approvedAt).to.not.be.null;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "A6 - Approve Plan - Fail (stale blocking)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/plan/{{planId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["plan", "{{planId}}", "approve"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejected with 400 when staleReason is blocking', function () {",
                  "    pm.response.to.have.status(400);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.false;",
                  "});",
                  "",
                  "// Skenario ini butuh precondition manual: plan berstatus draft dengan",
                  "// staleReason 'recipe_changed' atau 'menu_archived' (mis. edit Menu",
                  "// terkait dari Menu module setelah plan ini dibuat, sebelum request ini",
                  "// dikirim), untuk memverifikasi PRD Sec.5 langkah 3."
                ]
              }
            }
          ]
        },
        {
          "name": "A7 - Stop Plan (active only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Bahan baku ditarik karena isu kualitas\",\n  \"stoppedBy\": \"Admin Dapur\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/plan/{{planId}}/stop",
              "host": ["{{baseUrl}}"],
              "path": ["plan", "{{planId}}", "stop"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Plan is now stopped', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.status).to.eql('stopped');",
                  "    pm.expect(jsonData.data.stoppedAt).to.not.be.null;",
                  "    pm.expect(jsonData.data.stopReason).to.eql('Bahan baku ditarik karena isu kualitas');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Discount (per menu in plan)",
      "item": [
        {
          "name": "A9 - Set/Replace Discount",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"discountPercentage\": 20,\n  \"startDate\": \"2024-03-05\",\n  \"endDate\": \"2024-03-10\",\n  \"reason\": \"Batch mendekati kedaluwarsa (unsafe)\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/plan/{{planId}}/menus/{{menuId}}/discount",
              "host": ["{{baseUrl}}"],
              "path": ["plan", "{{planId}}", "menus", "{{menuId}}", "discount"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Discount applied with computed discountedPrice', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.discount).to.have.property('discountedPrice');",
                  "    pm.expect(jsonData.data.discount).to.have.property('discountStatus');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "A9 - Set Discount - Fail (endDate melebihi plan)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"discountPercentage\": 20,\n  \"startDate\": \"2024-03-05\",\n  \"endDate\": \"2099-01-01\",\n  \"reason\": \"Test validasi endDate\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/plan/{{planId}}/menus/{{menuId}}/discount",
              "host": ["{{baseUrl}}"],
              "path": ["plan", "{{planId}}", "menus", "{{menuId}}", "discount"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejected with 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "A10 - Remove Discount",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/plan/{{planId}}/menus/{{menuId}}/discount",
              "host": ["{{baseUrl}}"],
              "path": ["plan", "{{planId}}", "menus", "{{menuId}}", "discount"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Discount removed', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.discount).to.be.null;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
