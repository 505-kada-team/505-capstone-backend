{
  "info": {
    "name": "KADA Backend - Plan Report API",
    "_postman_id": "kada-plan-report-api",
    "description": "Plan Report endpoints (C1-C4) untuk KADA Backend. Base path DIASUMSIKAN /api/v1/plan-reports (belum dikonfirmasi ke index.js/app.js asli -- sesuaikan baseUrl kalau berbeda). reportedBy/reportedByRole (C1), reviewedBy (C3), replacedBy (C4) SEMUA diambil server-side dari req.user (Authorization Bearer token) -- TIDAK ADA di body manapun di collection ini, sesuai keputusan keamanan yang sama dengan cashierName di Selling.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    }
  ],
  "item": [
    {
      "name": "C1 - Lapor Kerugian",
      "item": [
        {
          "name": "C1 - Lapor (kategori menu, kasir -> pending)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{planId}}\",\n  \"category\": \"menu\",\n  \"refId\": \"{{menuId}}\",\n  \"quantityLost\": 2,\n  \"incidentAt\": \"2026-08-05T03:15:00.000Z\",\n  \"reason\": \"Terjatuh saat penyajian\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/plan-reports",
              "host": ["{{baseUrl}}"],
              "path": ["plan-reports"]
            },
            "description": "Login sebagai user role KASIR untuk request ini -- reportedByRole otomatis 'cashier', status hasil 'pending'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Laporan pending, valuation lengkap untuk kategori menu', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.status).to.eql('pending');",
                  "    pm.expect(jsonData.data.category).to.eql('menu');",
                  "    pm.expect(jsonData.data.valuation).to.not.be.null;",
                  "    pm.expect(jsonData.data.valuation).to.have.property('costLoss');",
                  "    pm.expect(jsonData.data.valuation).to.have.property('lostRevenueEstimate');",
                  "    pm.expect(jsonData.data.valuation).to.have.property('costComplete');",
                  "});",
                  "",
                  "pm.test('Store report ID (menu category)', function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data._id) {",
                  "        pm.environment.set('planReportIdMenu', jsonData.data._id);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "C1 - Lapor (kategori ingredient, admin -> auto-approved)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{planId}}\",\n  \"category\": \"ingredient\",\n  \"refId\": \"{{inventoryId}}\",\n  \"quantityLost\": 200,\n  \"incidentAt\": \"2026-08-04T08:00:00.000Z\",\n  \"reason\": \"Basi karena kemasan bocor saat pengiriman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/plan-reports",
              "host": ["{{baseUrl}}"],
              "path": ["plan-reports"]
            },
            "description": "Login sebagai user role ADMIN untuk request ini -- reportedByRole otomatis 'admin', status hasil langsung 'approved', valuation: null (kategori ingredient), dan hasPendingLossReplacement plan induk otomatis jadi true."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Laporan ingredient dari admin langsung approved, valuation null', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.status).to.eql('approved');",
                  "    pm.expect(jsonData.data.category).to.eql('ingredient');",
                  "    pm.expect(jsonData.data.valuation).to.be.null;",
                  "    pm.expect(jsonData.data.reviewedBy).to.not.be.null;",
                  "});",
                  "",
                  "pm.test('Store report ID (ingredient category)', function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data._id) {",
                  "        pm.environment.set('planReportIdIngredient', jsonData.data._id);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "C1 - Lapor - Fail (incidentAt di masa depan)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{planId}}\",\n  \"category\": \"menu\",\n  \"refId\": \"{{menuId}}\",\n  \"quantityLost\": 1,\n  \"incidentAt\": \"2099-01-01T00:00:00.000Z\",\n  \"reason\": \"Test validasi tanggal masa depan\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/plan-reports",
              "host": ["{{baseUrl}}"],
              "path": ["plan-reports"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejected with 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "C1 - Lapor - Fail (plan draft/cancelled)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{planIdDraft}}\",\n  \"category\": \"menu\",\n  \"refId\": \"{{menuId}}\",\n  \"quantityLost\": 1,\n  \"incidentAt\": \"2026-08-05T03:15:00.000Z\",\n  \"reason\": \"Test validasi status plan\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/plan-reports",
              "host": ["{{baseUrl}}"],
              "path": ["plan-reports"]
            },
            "description": "Isi planIdDraft manual dengan _id plan yang masih berstatus draft/cancelled."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejected with 409', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "C2 - List Laporan",
      "item": [
        {
          "name": "C2 - List semua laporan (tanpa filter)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/plan-reports",
              "host": ["{{baseUrl}}"],
              "path": ["plan-reports"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response berbentuk array dengan nameRef ter-resolve', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "    if (jsonData.data.length > 0) {",
                  "        pm.expect(jsonData.data[0]).to.have.property('nameRef');",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "C2 - Filter by planId + status + category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/plan-reports?planId={{planId}}&status=pending&category=menu",
              "host": ["{{baseUrl}}"],
              "path": ["plan-reports"],
              "query": [
                { "key": "planId", "value": "{{planId}}" },
                { "key": "status", "value": "pending" },
                { "key": "category", "value": "menu" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Semua hasil match filter', function () {",
                  "    var jsonData = pm.response.json();",
                  "    jsonData.data.forEach(function (r) {",
                  "        pm.expect(r.status).to.eql('pending');",
                  "        pm.expect(r.category).to.eql('menu');",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "C3 - Review Laporan",
      "item": [
        {
          "name": "C3 - Approve laporan (kategori menu)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approved\",\n  \"adminNote\": \"Sudah dicek, sesuai laporan\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/plan-reports/{{planReportIdMenu}}/review",
              "host": ["{{baseUrl}}"],
              "path": ["plan-reports", "{{planReportIdMenu}}", "review"]
            },
            "description": "Login sebagai ADMIN. Efek: menus[].lossQuantity plan terkait bertambah sejumlah quantityLost laporan ini, dan soldOutAt bisa ikut terisi kalau remainingQuantity menu tsb jadi 0."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Laporan approved, reviewedBy/reviewedAt terisi', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.status).to.eql('approved');",
                  "    pm.expect(jsonData.data.reviewedBy).to.not.be.null;",
                  "    pm.expect(jsonData.data.reviewedAt).to.not.be.null;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "C3 - Reject laporan",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"rejected\",\n  \"adminNote\": \"Tidak sesuai dengan CCTV, ditolak\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/plan-reports/{{planReportIdReject}}/review",
              "host": ["{{baseUrl}}"],
              "path": ["plan-reports", "{{planReportIdReject}}", "review"]
            },
            "description": "Isi planReportIdReject manual dengan laporan lain yang masih pending -- supaya tidak bentrok dengan skenario approve di atas (1 laporan cuma bisa direview sekali)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Laporan rejected', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.status).to.eql('rejected');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "C3 - Review - Fail (sudah pernah direview)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approved\",\n  \"adminNote\": \"Coba review dua kali\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/plan-reports/{{planReportIdMenu}}/review",
              "host": ["{{baseUrl}}"],
              "path": ["plan-reports", "{{planReportIdMenu}}", "review"]
            },
            "description": "Jalankan SETELAH request 'C3 - Approve laporan' di atas -- laporan yang sama, sudah bukan pending lagi."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejected with 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "C4 - Tarik Stok Pengganti",
      "item": [
        {
          "name": "C4 - Add inventory replacement",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"replacementQuantity\": 200,\n  \"availableUntil\": \"2026-08-19T00:00:00.000Z\",\n  \"varianceNote\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/plan-reports/{{planReportIdIngredient}}/add-inventory",
              "host": ["{{baseUrl}}"],
              "path": ["plan-reports", "{{planReportIdIngredient}}", "add-inventory"]
            },
            "description": "Precondition: laporan berstatus approved, category: ingredient, replacementDeducted: false, DAN plan terkait masih berstatus active. Kalau replacementQuantity dikosongkan, default-nya = quantityLost laporan."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Stok pengganti tercatat', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('replacementBatches');",
                  "    pm.expect(jsonData.data).to.have.property('replacementCost');",
                  "    pm.expect(jsonData.data.replacementBatches).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "C4 - Add inventory - Fail (sudah pernah diganti)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"replacementQuantity\": 200\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/plan-reports/{{planReportIdIngredient}}/add-inventory",
              "host": ["{{baseUrl}}"],
              "path": ["plan-reports", "{{planReportIdIngredient}}", "add-inventory"]
            },
            "description": "Jalankan SETELAH request 'C4 - Add inventory replacement' di atas -- laporan yang sama, replacementDeducted sudah true."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejected with 409', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
